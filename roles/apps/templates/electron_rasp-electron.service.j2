[Unit]
Description=Electron kiosk (electron_rasp)
After=graphical.target electron_rasp-flask.service
Wants=graphical.target
Requires=electron_rasp-flask.service
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
User={{ kiosk_user }}
WorkingDirectory={{ electron_app_dir }}

Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/{{ kiosk_user }}/.Xauthority
Environment="BRANCH_ID={{ BRANCH_ID }}"
Environment="KIOSK_URL=http://127.0.0.1:5000"
Environment="SPAWN_FLASK=0"

# El wrapper calcula XDG_RUNTIME_DIR/PULSE_SERVER con el UID real y fuerza
# PULSE_SINK al HDMI seleccionado. Ya no se hardcodea /run/user/1000.

# dar 2s para que el display esté 100% listo
ExecStartPre=/bin/sleep 2
{% if display_orientation is defined %}
# Solo se agrega en hosts que definan display_orientation en inventory/host_vars.
# Si no existe la variable, el servicio queda con el comportamiento landscape actual.
ExecStartPre=/usr/local/bin/configure_kiosk_display.sh {{ display_orientation }}
{% endif %}
{% if kiosk_audio_enabled | default(true) %}
ExecStart=/usr/local/bin/start_kiosk_electron.sh {{ kiosk_hdmi_connector | default('HDMI-A-1') }} {{ kiosk_audio_volume | default('100') }}
{% else %}
ExecStart=/usr/bin/npm run electron
{% endif %}

KillMode=control-group
TimeoutStopSec=15s
Restart=always
RestartSec=2s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
